---
import SectionHeading from './SectionHeading.astro';

// 所要時間で選ぶ、定番の回り方（類型中立）
const routes = [
  {
    title: '半日コース',
    time: '約3時間',
    body: '市場で海の幸を味わい、史跡をたどってから公園へ。海底を歩く体験まで含めた、無理のない半日の組み方です。',
    path: ['唐戸市場（寿司・海鮮）', '赤間神宮', 'みもすそ川公園', '関門トンネル人道（海底県境）'],
    tips: ['午前の市場がおすすめ', '人道は往復ベース', 'バスで御裳川下車']
  },
  {
    title: '一日コース',
    time: '終日',
    body: '下関と門司の両岸をつなぐ、海峡をぐるりと回る一日。連絡船で海から戻る輪ができ、移動の変化も楽しめます。',
    path: ['下関駅', '唐戸市場', '赤間神宮', 'みもすそ川公園', '関門トンネル人道', '門司側（和布刈・門司港レトロ）', '関門連絡船で唐戸へ'],
    tips: ['連絡船で闭环', '門司側は別途移動', '一日分の歩行ペースで']
  }
];
---

<section class="section" id="routes" aria-labelledby="routes-title">
  <div class="shell">
    <SectionHeading
      eyebrow="定番の回り方"
      title="半日と一日、二つのモデルコース"
      lead="使える時間で選べる、公園を中心にした定番のルートです。交通や営業は日によって変わるため、各公式情報をあわせてご確認ください。"
    />
    <div class="routes2">
      {routes.map((r) => (
        <article class="route2-card" data-reveal>
          <div class="route2-card__head">
            <h3 class="route2-card__title">{r.title}</h3>
            <span class="route2-card__time">{r.time}</span>
          </div>
          <p class="route2-card__body">{r.body}</p>
          <ol class="route2-path">
            {r.path.map((p) => <li>{p}</li>)}
          </ol>
          <div class="route2-tips">
            {r.tips.map((t) => <span>{t}</span>)}
          </div>
        </article>
      ))}
    </div>
    <p style="margin-top:30px;text-align:center">
      <a class="text-link" href="/itineraries/">もっと細かいモデルコースを見る <span aria-hidden="true">→</span></a>
    </p>
  </div>
</section>
