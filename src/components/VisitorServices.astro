---
import SectionHeading from './SectionHeading.astro';

// 類型中立の施設概要（特定の店名・事業者名は挙げず、カテゴリで紹介）
const services = [
  {
    icon: 'WC',
    title: 'トイレ・授乳・多機能トイレ',
    body: '関門トンネル人道の下関側入口施設に多機能トイレとエレベーターがあり、小さなお子様連れや車いすの方も利用しやすくなっています。公園周辺にも公共のトイレが点在します。'
  },
  {
    icon: '車',
    title: '駐車場',
    body: '人道の下関側入口に無料の一般駐車場があり、普通車と大型バス（台数に上限あり）に対応しています。満車時は近隣の市場周辺の駐車場と路線バスを組み合わせる方法もあります。'
  },
  {
    icon: '食',
    title: '飲食（軽食・休憩）',
    body: '公園近くには海峡の眺望を楽しめる飲食施設や、老舗のふく料理（山口県の特産）をふるまう旅館・料亭、気軽なカフェなど複数の形態があります。営業日や予算の確認は各店舗の最新情報で行ってください。'
  },
  {
    icon: '泊',
    title: '宿泊',
    body: '海峡沿いや下関・唐戸エリアには、旅館・ホテル・ビジネス宿がそろっています。公園を含めた一日の行程の拠点として、海側か駅側かで滞在エリアを選ぶと移動が楽になります。'
  },
  {
    icon: '買',
    title: '買い物・土産',
    body: '近隣の市場や海辺の商業施設では、水産物や加工品、海峡の銘菓などを扱う店が並びます。営業時間が日によって異なる店もあるため、到着前に確認をおすすめします。'
  },
  {
    icon: 'コ',
    title: 'コンビニ・日用品',
    body: '下関駅や唐戸方面を含む周辺には、コンビニエンスストアや薬局があり、飲料・雨具・日焼け止めなどの急な買い物に便利です。公園直近には店が少ないため、通り道でそろえておくと安心です。'
  },
  {
    icon: '充',
    title: '給油・充電（EV）',
    body: '自動車で訪れる場合、下関インターチェンジ周辺にガソリンスタンドがあり、市街地や道の駅・観光施設には電気自動車（EV）の充電設備を備える地点も見られます。充電の空き状況は事前の検索サービスでご確認ください。'
  },
  {
    icon: '預',
    title: '手荷物・コインロッカー',
    body: '大きな荷物は、下関駅や唐戸・門司港の観光拠点にあるコインロッカーや手荷物預かりの利用が便利です。公園内に預かりはないため、海峡を歩く前に駅などで軽くなると動きやすくなります。'
  },
  {
    icon: '金',
    title: '現金・ATM',
    body: '市場の一部店舗や小型の店では現金が必要な場合があります。下関駅や市街地の金融機関・コンビニATMで引き出しができます。小銭と現金を少し用意しておくと、市場やトイレの利用で困りにくくなります。'
  },
  {
    icon: 'Wi',
    title: '公衆無線LAN・電話',
    body: '主要な駅や観光施設では公衆無線LANを利用できる地点があります。海峡沿いは電波が届きにくい場所もあるため、待ち合わせは目印となる像や橋を基準にすると安心です。'
  },
  {
    icon: 'ペ',
    title: 'ペット同伴',
    body: '園路の散策はリードを着けた小型ペットの同伴が可能な場所が多いです。人道内や他の利用者への配慮、排泄物の処理をお願いします。店内・施設によって可否が異なるため、各店舗情報で確認してください。'
  },
  {
    icon: '救',
    title: '医療・救急',
    body: '体調不良やケガの際は、下関市内の救急医療機関や薬局をご利用ください。公園は海沿いで風が強い日があります。熱中症や転倒に備え、飲み物と無理のない歩行ペースを心がけてください。'
  },
  {
    icon: '案',
    title: '観光案内',
    body: '山口県・下関市の公式観光窓口や現地の案内板で、史跡の説明やイベント情報を確認できます。紙芝居や長州砲の演出は季節や運営で変わるため、最新情報をあわせてご参照ください。'
  }
];
---

<section class="section" id="services" aria-labelledby="services-title">
  <div class="shell">
    <SectionHeading
      eyebrow="访客のために"
      title="周辺の施設とサービス"
      lead="特定の店舗名は挙げず、旅行中に役立つ施設の「種類」を中立的にまとめました。詳細は各公式情報でご確認ください。"
    />
    <div class="services-grid">
      {services.map((s) => (
        <article class="service-card" data-reveal>
          <span class="service-card__icon" aria-hidden="true">{s.icon}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
