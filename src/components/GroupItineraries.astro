---
import SectionHeading from './SectionHeading.astro';

// 三つの旅行構成に合わせたルート（類型別）
const groups = [
  {
    key: 'family',
    tag: '亲子家庭',
    title: '家族で歩く、物語と潮の旅',
    time: '約90分',
    body: '平坦な園路とエレベーターがある人道を中心に、子どもにも分かりやすい見どころをつなぎます。像と橋、海底県境は写真の記念になります。',
    path: ['御裳川バス停', '義経・知盛像', '古戦場碑', '長州砲', '関門トンネル人道（海底県境）'],
    tips: ['休憩をはさむ', '車いす・ベビーカー可', '風が強い日は雨具']
  },
  {
    key: 'photo',
    tag: '摄影自然',
    title: '光と潮を撮る、海峡の構図旅',
    time: '半日',
    body: '橋の斜線、潮の筋、貨物船の動きを待つ構図を中心に、朝と夕方の光を使い分けます。人道の県境では通路を優先して短く撮影します。',
    path: ['像と関門橋', '長州砲と航路', '海峡の潮流', '橋を見上げる', '海底県境'],
    tips: ['三脚は通路を塞がず', '順光・逆光を使い分け', '夜は足元注意']
  },
  {
    key: 'accessible',
    tag: '低体力无障碍',
    title: 'ゆっくり、無理なく巡る旅',
    time: '約60分',
    body: '歩行距離を最小にし、ベンチやトイレの近い園路を往復します。海底まではエレベーター付きの人道を短く往復するのがおすすめです。',
    path: ['御裳川バス停', '園内ベンチで潮を観察', '義経・知盛像', '古戦場碑', '多機能トイレ・休憩'],
    tips: ['無理な坂は避ける', '日影と水分を確保', '往復ベースで計画']
  }
];
---

<section class="section" id="groups" aria-labelledby="groups-title">
  <div class="shell">
    <SectionHeading
      eyebrow="旅の構成で選ぶ"
      title="三つの滞在プラン"
      lead="ご家族、撮影、ゆっくり歩き——訪れる方の構成に合わせて、同じ公園を別の密度でめぐります。"
    />
    <div class="group-routes">
      {groups.map((g) => (
        <article class="group-route" data-reveal>
          <div class="group-route__intro">
            <span class="group-route__tag">{g.tag}</span>
            <span class="group-route__time">{g.time}</span>
            <h3>{g.title}</h3>
          </div>
          <div class="group-route__body">
            <p>{g.body}</p>
            <ol class="group-route__path">
              {g.path.map((p) => <li>{p}</li>)}
            </ol>
            <div class="group-route__tips">
              {g.tips.map((t) => <span>{t}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
    <p style="margin-top:30px;text-align:center">
      <a class="text-link" href="/itineraries/">半日・一日のモデルコースを見る <span aria-hidden="true">→</span></a>
    </p>
  </div>
</section>
