---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { faqSections, faqItems } from '@/data/attraction';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};
---

<Layout
  title="みもすそ川公園のよくある質問｜駐車場・所要時間・入園料・長州砲"
  description="みもすそ川公園の入園料、無料駐車場、観光所要時間、長州砲の演出時間、バスでのアクセスなど、訪問前によくある疑問を分かりやすく解説します。"
  schema={faqSchema}
>
  <PageHero
    eyebrow="旅の手引き"
    title="出発前の疑問を、ここで。"
    lead="公園の料金と所要時間、バス、駐車場、海底トンネル、子ども連れ。現地で迷いやすいことを、旅の順番に沿ってまとめました。"
    image="/images/mimosuso-bridge.jpg"
    imageAlt="みもすそ川公園の赤い橋と関門橋"
    position="center"
  />

  {
    faqSections.map((section) => (
      <section class="section section--white">
        <div class="shell">
          <SectionHeading eyebrow="公園について" title={section.heading} />
          <div class="faq-list narrow">
            {section.items.map((item, i) => (
              <details open={section.heading === '公園について' && i === 0}>
                <summary>
                  <span class="faq-list__q">問</span>
                  <span>{item.question}</span>
                  <span class="faq-list__toggle" aria-hidden="true"></span>
                </summary>
                <div class="faq-list__answer"><p>{item.answer}</p></div>
              </details>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section">
    <div class="shell">
      <div class="notice narrow" style="margin-top:34px">
        <span>注</span>
        <div>交通、施設、演出の内容は変更される場合があります。出発前に公式観光情報と現地案内をご確認ください。</div>
      </div>
    </div>
  </section>
</Layout>
